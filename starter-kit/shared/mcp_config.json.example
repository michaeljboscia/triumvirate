{
  "_comment": [
    "MCP server configuration for Claude Code.",
    "Copy this to ~/.claude.json (or merge into existing).",
    "Replace <TRIUMVIRATE_PATH> with your clone path (e.g., ~/projects/triumvirate).",
    "The inter-agent servers are the core of the triumvirate system.",
    "Other servers (supabase, github, etc.) are optional and configured separately."
  ],
  "mcpServers": {
    "inter-agent-gemini": {
      "command": "node",
      "args": ["<TRIUMVIRATE_PATH>/mcp-server/dist/gemini/server.js"],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "PYTHIA_HOME": "${HOME}/.pythia",
        "AI_MEMORY_DIR": "${HOME}/.ai-memory"
      }
    },
    "inter-agent-codex": {
      "command": "node",
      "args": ["<TRIUMVIRATE_PATH>/mcp-server/dist/codex/server.js"],
      "env": {}
    }
  }
}

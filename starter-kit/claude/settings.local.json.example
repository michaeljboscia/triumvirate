{
  "_comment": "Oracle permissions for settings.local.json. Copy to ~/.claude/settings.local.json. Decommission tools require manual approval (destructive).",
  "permissions": {
    "allow": [
      "mcp__triumvirate__oracle_init",
      "mcp__triumvirate__oracle_health",
      "mcp__triumvirate__oracle_refresh",
      "mcp__triumvirate__oracle_sync_corpus",
      "mcp__triumvirate__oracle_pressure_check",
      "mcp__triumvirate__oracle_log_learning",
      "mcp__triumvirate__oracle_checkpoint",
      "mcp__triumvirate__oracle_salvage",
      "mcp__triumvirate__oracle_reconstitute",
      "mcp__triumvirate__oracle_quality_report",
      "mcp__triumvirate__oracle_add_to_corpus",
      "mcp__triumvirate__oracle_update_entry",
      "mcp__triumvirate__spawn_oracle"
    ],
    "ask": [
      "mcp__triumvirate__oracle_decommission_request",
      "mcp__triumvirate__oracle_decommission_cancel",
      "mcp__triumvirate__oracle_decommission_execute"
    ]
  }
}

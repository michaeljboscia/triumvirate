{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main Pantheon window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:menu:default",
    "core:tray:default",
    "core:image:default",
    "core:event:default",
    "opener:default",
    "prevent-default:default"
  ]
}
